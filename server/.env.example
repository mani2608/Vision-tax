PORT=4000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=vision_tax

# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Private directory for uploads (keep outside any public web root)
UPLOAD_DIR=./storage
MAX_FILE_MB=10
MAX_FILES_PER_UPLOAD=10

# Razorpay (TEST mode keys start with rzp_test_). Keep the secret on the server only; never commit real values.
# RAZORPAY_WEBHOOK_SECRET is the secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used ONLY by `npm run seed` to create the first admin. Leave blank in source control.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OPTIONAL default country (ISO code, e.g. IN or US) pre-selected in phone fields. It does NOT restrict which countries are accepted; every valid international number works. Leave blank for no default.
PHONE_REGION=US
